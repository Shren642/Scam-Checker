# Gemini API Configuration
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Flask Secret Key
SECRET_KEY=generate_a_random_secret_key_here

# Meta WhatsApp Business Cloud API (Optional - for live WhatsApp webhook)
WHATSAPP_TOKEN=your_meta_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=scam_check_verify_token_123

# Twilio WhatsApp Configuration (Alternative to Cloud API)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=whatsapp:+14155238886
